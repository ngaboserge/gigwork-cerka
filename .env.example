# Cerka Gig Work Platform - Environment Configuration

# Supabase Configuration (Create separate Supabase project for gig work)
VITE_SUPABASE_URL=https://your-gig-work-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-gig-work-anon-key

# App Configuration
VITE_APP_NAME="Cerka Gig Work"
VITE_APP_DESCRIPTION="Find flexible work opportunities in Rwanda"
VITE_APP_URL=https://gigwork.cerka.rw

# Features
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
VITE_SENTRY_DSN=your-sentry-dsn

# Development
VITE_DEBUG_MODE=false